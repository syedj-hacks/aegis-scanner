# ── Aegis Shield environment ────────────────────────────────────────────────
# Copy this file to `.env` (run.sh / run.bat do it for you on first run) and
# edit the values below. `.env` is gitignored and must never be committed.
#
# These same variables are what you set in the SnapDeploy / Render dashboard
# for a live deploy — see DEPLOY.md.

# Secret used to sign login tokens. MUST be changed to a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# The single administrator account, created on first boot.
# Use a NORMAL domain — .local / .test addresses fail e-mail validation and
# lock you out. Change the password before first sign-in.
ADMIN_EMAIL=admin@aegisshield.app
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Database. Default (leave unset / as-is) is SQLite on a Docker volume — zero
# setup, survives rebuilds. For Postgres, enable the `db` service in
# docker-compose.yml and use e.g.:
#   DATABASE_URL=postgresql+psycopg2://aegis:aegis@db:5432/aegis
DATABASE_URL=sqlite:////app/saas-platform/backend/data/aegis_shield.db

# Host port the app is published on (container always listens on 8000).
APP_PORT=8000

# Browser origins allowed to call the API. The app serves its own frontend
# same-origin, so for the local one-click run you can leave this as-is.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
