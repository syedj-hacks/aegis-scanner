# Path to the Aegis Scanner engine checkout (imported as a library, not shelled out to).
AEGIS_REPO_PATH=/home/jafar/aegis-scanner

# Postgres connection for app data (users, subscriptions, payments, scan_jobs, admin_actions).
# Aegis's own SQLite (database/aegis.db under AEGIS_REPO_PATH) is untouched and kept separate.
DATABASE_URL=postgresql+psycopg2://aegis_saas:aegis_saas@localhost:5432/aegis_saas

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# The ONE admin account. Only seed_admin.py ever creates an admin row.
# Must be a normal-looking domain: .local/.test addresses fail email validation at sign-in.
ADMIN_EMAIL=admin@aegisshield.app
ADMIN_PASSWORD=ChangeThisAdminPassword123!

CORS_ORIGINS=http://localhost:5173
